<%- include('partials/header.ejs'); -%>

<main class="card">
  <header class="card__header">
    <div class="card__heading">
      <h1 class="card__title"><%= listTitle %></h1>
      <p class="card__date" id="date"></p>
    </div>
    <span class="card__count">
      <%= listItems.length %> task<%= listItems.length === 1 ? "" : "s" %>
    </span>
  </header>

  <% if (error) { %>
    <div class="alert" role="alert">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
      <span><%= error %></span>
    </div>
  <% } %>

  <div class="list">
    <% for (const item of listItems) { %>
      <div class="item" data-id="<%= item.id %>">
        <form class="item__check" action="/delete" method="post">
          <input type="hidden" name="deleteItemId" value="<%= item.id %>" />
          <label class="checkbox" title="Mark as done">
            <input type="checkbox" class="item__checkbox" aria-label="Mark as done" />
            <span class="checkbox__mark">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 6L9 17l-5-5"></path>
              </svg>
            </span>
          </label>
        </form>

        <span class="item__title"><%= item.todo %></span>

        <form class="item__edit-form" id="edit-<%= item.id %>" action="/edit" method="post" hidden>
          <input type="hidden" name="updatedItemId" value="<%= item.id %>" />
          <input
            class="item__input"
            type="text"
            name="updatedItemTitle"
            value="<%= item.todo %>"
            maxlength="100"
            autocomplete="off"
          />
        </form>

        <div class="item__actions">
          <button type="button" class="icon-btn" data-action="edit" aria-label="Edit task" title="Edit">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 20h9"></path>
              <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
            </svg>
          </button>
          <button type="submit" form="edit-<%= item.id %>" class="icon-btn icon-btn--save" data-action="save" aria-label="Save task" title="Save" hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 6L9 17l-5-5"></path>
            </svg>
          </button>
          <button type="button" class="icon-btn icon-btn--cancel" data-action="cancel" aria-label="Cancel edit" title="Cancel" hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
      </div>
    <% } %>

    <% if (listItems.length === 0) { %>
      <div class="empty">
        <svg class="empty__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"></path>
          <rect x="9" y="3" width="6" height="4" rx="1"></rect>
          <path d="M9 12l2 2 4-4"></path>
        </svg>
        <p class="empty__text">All clear! Add your first task below.</p>
      </div>
    <% } %>

    <form class="add-form" action="/add" method="post">
      <input
        class="add-form__input"
        type="text"
        name="newItem"
        placeholder="Add a new task&hellip;"
        autocomplete="off"
        autofocus
        required
        maxlength="100"
      />
      <button class="add-form__btn" type="submit" aria-label="Add task" title="Add task">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
      </button>
    </form>
  </div>
</main>

<%- include('partials/footer.ejs'); -%>
